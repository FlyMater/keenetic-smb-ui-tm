#!/bin/sh
# prerm: stop the service before removing/replacing files.
set -e
/opt/etc/init.d/S99keenetic-smb-ui stop >/dev/null 2>&1 || true

# opkg may replace the conffile on upgrade/reinstall: keep a copy so postinst can
# restore it. Losing config.json looks exactly like "all disks disappeared".
CFG=/opt/etc/keenetic-smb-ui/config.json
if [ -s "$CFG" ]; then
  cp -a "$CFG" "$CFG.bak-auto" 2>/dev/null || true
fi
exit 0
