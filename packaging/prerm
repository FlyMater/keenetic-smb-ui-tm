#!/bin/sh
set -eu
ROOT=${IPKG_INSTROOT:-}
BASE="$ROOT/opt/etc/keenetic-smb-ui"
CFG="$BASE/config.json"
if [ -z "$ROOT" ]; then
  "$ROOT/opt/etc/init.d/S99keenetic-smb-ui" stop
fi
if [ -s "$CFG" ]; then
  umask 077
  TMP=$(mktemp "$BASE/.config-backup.XXXXXX")
  trap 'rm -f "$TMP"' EXIT
  cat "$CFG" > "$TMP"
  mv "$TMP" "$CFG.bak-upgrade"
fi
