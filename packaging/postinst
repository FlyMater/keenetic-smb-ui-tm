#!/bin/sh
set -eu
ROOT=${IPKG_INSTROOT:-}
BASE="$ROOT/opt/etc/keenetic-smb-ui"
SERVICE="$ROOT/opt/etc/init.d/S99keenetic-smb-ui"
CFG="$BASE/config.json"
umask 077
mkdir -p "$BASE" "$ROOT/opt/var/keenetic-smb-ui/log"
if [ ! -e "$CFG" ]; then
  SOURCE="$BASE/config.default.json"
  for backup in "$CFG.bak-upgrade" "$CFG.bak-auto" "$CFG.bak-setpass"; do
    if [ -s "$backup" ]; then
      SOURCE="$backup"
      break
    fi
  done
  TMP=$(mktemp "$BASE/.config-install.XXXXXX")
  trap 'rm -f "$TMP"' EXIT
  cat "$SOURCE" > "$TMP"
  mv "$TMP" "$CFG"
fi
chmod 600 "$CFG"
if [ -z "$ROOT" ]; then
  "$SERVICE" start
fi
